APP_NAME=SnapManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL da SPA React (origem separada do backend). Usada para montar links que
# apontam pro front-end, como o link de redefinição de senha enviado por
# e-mail/log — ver App\Providers\AppServiceProvider.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snapmanager
DB_SSLMODE=disable
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Disco de storage das imagens de galeria (privado, servido só pelas rotas
# controladas da API — ver App\Http\Controllers\Api\GalleryController). Para
# usar S3 no futuro, troque para "s3" e preencha as variáveis AWS_* abaixo;
# nenhuma mudança de código é necessária (config/filesystems.php já define
# o disco "s3").
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em ambiente local não há envio de e-mail real: com MAIL_MAILER=log, o
# corpo de qualquer e-mail (ex.: link de redefinição de senha) é gravado em
# storage/logs/laravel.log em vez de ser enviado de verdade. Veja DEMO.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Login com Google (Laravel Socialite). Deixe em branco para manter o botão
# "Entrar com Google" oculto no front-end — nenhuma outra configuração é
# necessária para rodar o restante do sistema sem essas credenciais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Assinatura eletrônica — Clicksign API 3.0. Use a URL do Sandbox em
# desenvolvimento. O Access Token é SECRETO: gere no painel da Clicksign
# (Configurações > API) e cole só no seu .env local, nunca aqui.
# Teste a conexão com: php artisan clicksign:check
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com/api/v3
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_TIMEOUT=15
# Secret HMAC do webhook (gerado pela Clicksign ao cadastrar a URL do
# webhook). Também é segredo: só no .env local.
CLICKSIGN_WEBHOOK_SECRET=

# Conversão de contratos Word (.docx) para PDF — LibreOffice headless.
# Caminho do executável (ou só o nome, se estiver no PATH). Exemplos:
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux:   /usr/bin/soffice
# Vazio = procura "soffice" no PATH. Sem LibreOffice, só PDF é aceito para
# assinatura (Word fica salvo como rascunho, com a conversão pendente).
DOCUMENT_CONVERTER_BINARY=
DOCUMENT_CONVERTER_TIMEOUT=90
# Diretório temporário das conversões (vazio = storage/framework/document-conversions).
DOCUMENT_CONVERTER_TEMP_PATH=

VITE_APP_NAME="${APP_NAME}"
