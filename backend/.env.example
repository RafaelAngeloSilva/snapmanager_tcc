# Configuração de DESENVOLVIMENTO local. Para produção na Railway, as
# variáveis são definidas no painel — ver docs/deploy-railway.md.
APP_NAME=SnapManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL da SPA React (origem separada do backend). Usada para montar links que
# apontam pro front-end, como o link de redefinição de senha enviado por
# e-mail/log — ver App\Providers\AppServiceProvider.
FRONTEND_URL=http://localhost:5173

# Origens que podem chamar a API pelo navegador (CORS), separadas por
# vírgula. Vazio = só FRONTEND_URL. Com APP_ENV=local, localhost e a rede
# local (qualquer porta) também são aceitos. Ver config/cors.php.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Cadastro público (POST /api/register cria conta de ATENDENTE). Ligado aqui
# só para desenvolvimento/demonstração; em produção fica DESLIGADO (padrão).
REGISTRATION_ENABLED=true

# Validade dos tokens de login, em minutos (padrão: 10080 = 7 dias).
# SANCTUM_TOKEN_EXPIRATION=10080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snapmanager
DB_SSLMODE=disable
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Disco padrão do Laravel (uso interno do framework). Não é onde ficam as
# fotos e documentos — para isso, veja SNAPMANAGER_FILESYSTEM_DISK abaixo.
FILESYSTEM_DISK=local

# Arquivos persistentes do SnapManager (fotos das galerias, documentos,
# fotos de perfil). Todo acesso passa por App\Services\FileStorage.
#   local → storage/app/private (desenvolvimento; não precisa de AWS)
#   s3    → bucket PRIVADO no Amazon S3 (produção; exige as variáveis AWS_*)
# Guia completo: docs/armazenamento-s3.md
SNAPMANAGER_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em ambiente local não há envio de e-mail real: com MAIL_MAILER=log, o
# corpo de qualquer e-mail (ex.: link de redefinição de senha) é gravado em
# storage/logs/laravel.log em vez de ser enviado de verdade. Veja DEMO.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Produção (Railway): MAIL_MAILER=brevo — API HTTPS da Brevo. A Railway
# bloqueia SMTP nos planos Trial/Hobby. Chave em Brevo > SMTP & API > API
# Keys; MAIL_FROM_ADDRESS precisa ser um remetente verificado na Brevo.
BREVO_API_KEY=

# Amazon S3 — obrigatórias SÓ com SNAPMANAGER_FILESYSTEM_DISK=s3. Use a
# credencial de um usuário IAM com permissão mínima no bucket (nunca a conta
# root). NUNCA coloque valores reais neste arquivo nem no Git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Só para serviços compatíveis com S3 (MinIO, Cloudflare R2...). Na AWS, vazios/false.
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Login com Google (Laravel Socialite). Deixe em branco para manter o botão
# "Continuar com Google" oculto no front-end — nenhuma outra configuração é
# necessária para rodar o restante do sistema sem essas credenciais.
# O Client Secret fica SÓ aqui (back-end); o React nunca o recebe.
# Conta Google sem cadastro só é criada se REGISTRATION_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A rota de retorno fica em routes/web.php (sem o prefixo /api).
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Assinatura eletrônica — Clicksign API 3.0. Use a URL do Sandbox em
# desenvolvimento. O Access Token é SECRETO: gere no painel da Clicksign
# (Configurações > API) e cole só no seu .env local, nunca aqui.
# Teste a conexão com: php artisan clicksign:check
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com/api/v3
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_TIMEOUT=15
# Secret HMAC do webhook (gerado pela Clicksign ao cadastrar a URL do
# webhook). Também é segredo: só no .env local.
CLICKSIGN_WEBHOOK_SECRET=

# Conversão de contratos Word (.docx) para PDF — LibreOffice headless.
# Caminho do executável (ou só o nome, se estiver no PATH). Exemplos:
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux:   /usr/bin/soffice
# Vazio = procura "soffice" no PATH. Sem LibreOffice, só PDF é aceito para
# assinatura (Word fica salvo como rascunho, com a conversão pendente).
DOCUMENT_CONVERTER_BINARY=
DOCUMENT_CONVERTER_TIMEOUT=90
# Diretório temporário das conversões (vazio = storage/framework/document-conversions).
DOCUMENT_CONVERTER_TEMP_PATH=

VITE_APP_NAME="${APP_NAME}"
